      async function deleteCustomer(customerId, customerName) {
        const customer = allCustomers.find((c) => c._id === customerId);
        
        // Không cho phép xóa account admin
        if (customer && customer.role === "admin") {
          alert("Không thể xóa tài khoản admin");
          return;
        }

        if (!confirm(`Bạn có chắc muốn xóa khách hàng "${customerName}"?`)) {
          return;
        }

        try {
          const res = await fetch(`/api/account/${customerId}`, {
            method: "DELETE",
            headers: {
              Authorization: `Bearer ${token}`,
            },
          });
          const data = await res.json();

          if (res.ok) {
            alert(data.message || data.msg || "Xóa khách hàng thành công");
            await loadCustomers();
          } else {
            alert(data.error || data.msg || "Không thể xóa khách hàng");
          }
        } catch (err) {
          console.error(err);
          alert("Lỗi kết nối server. Vui lòng thử lại.");
        }
      }

      function closeDetailModal() {
        customerDetailModal.classList.add("hidden");
      }

      // Event listeners
      resetCustomerFormBtn.addEventListener("click", () => {
        resetForm();
      });
      closeDetailModalBtn.addEventListener("click", closeDetailModal);
      searchInput.addEventListener("input", () => renderCustomers());

      customerDetailModal.addEventListener("click", (e) => {
        if (e.target === customerDetailModal) {
          closeDetailModal();
        }
      });

      customerForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        
        const customerId = document.getElementById("customerId").value;
        
        // Xác nhận trước khi chỉnh sửa hoặc thêm mới
        const actionText = isEditMode ? "cập nhật thông tin khách hàng này" : "thêm khách hàng mới";
        const confirmMessage = `Bạn có chắc chắn muốn ${actionText}?`;
        
        if (!confirm(confirmMessage)) {
          return; // Người dùng hủy, không thực hiện thao tác
        }
        
        // Kiểm tra nếu đang sửa account admin
        if (isEditMode && customerId) {
          const customer = allCustomers.find((c) => c._id === customerId);
          if (customer && customer.role === "admin") {
            alert("Không thể chỉnh sửa tài khoản admin");
            return;
          }
        }

        customerFormMessage.classList.remove("hidden");
        customerFormMessage.textContent = isEditMode ? "Đang cập nhật..." : "Đang thêm khách hàng...";
        customerFormMessage.className = "block text-xs mt-1 text-amber-400";

        const formData = new FormData(customerForm);

        try {
          let res;
          if (isEditMode) {
            // Kiểm tra account có address không để gọi đúng API
            const hasAddress = currentEditCustomerAddresses && currentEditCustomerAddresses.length > 0;
            const apiEndpoint = hasAddress 
              ? `/api/account/${customerId}/with-address`
              : `/api/account/${customerId}/without-address`;
            
            res = await fetch(apiEndpoint, {
              method: "PUT",
              headers: {
                Authorization: `Bearer ${token}`,
              },
              body: formData,
            });
          } else {
            // Tạo account mới - chuyển formData thành JSON
            const formDataObj = {};
            formData.forEach((value, key) => {
              formDataObj[key] = value;
            });
            
            res = await fetch("/api/account/register", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                Authorization: `Bearer ${token}`,
              },
              body: JSON.stringify({
                name: formDataObj.name,
                email: formDataObj.email,
                pass: formDataObj.pass,
                role: formDataObj.role || "user",
                phone: formDataObj.phone,
                address: formDataObj.address,
                is_active: formDataObj.is_active === "true" || formDataObj.is_active === true,
              }),
            });
          }

          const data = await res.json();

          if (res.ok) {
            customerFormMessage.textContent = data.message || data.msg || "Thành công!";
            customerFormMessage.className = "block text-xs mt-1 text-emerald-400";
            await loadCustomers();
            setTimeout(() => {
              resetForm();
            }, 1000);
          } else {
            customerFormMessage.textContent = data.error || data.msg || "Có lỗi xảy ra";
            customerFormMessage.className = "block text-xs mt-2 text-rose-400";
          }
        } catch (err) {
          console.error(err);
          customerFormMessage.textContent = "Lỗi kết nối server. Vui lòng thử lại.";
          customerFormMessage.className = "block text-xs mt-2 text-rose-400";
        }
      });

      // Make functions available globally
      window.viewCustomerDetail = viewCustomerDetail;
      window.editCustomer = editCustomer;
      window.deleteCustomer = deleteCustomer;

      // Image preview
      document.getElementById("customerImage").addEventListener("change", (e) => {
        const file = e.target.files[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = (e) => {
            document.getElementById("previewImg").src = e.target.result;
            document.getElementById("customerImagePreview").classList.remove("hidden");
          };
          reader.readAsDataURL(file);
        }
      });

      // Khởi chạy
      resetForm();
      loadCustomers();
    </script>
  </body>
</html>
