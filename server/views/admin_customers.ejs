              </h3>
              <div class="flex gap-4 mb-4">
                <div class="h-20 w-20 rounded-full bg-slate-800 overflow-hidden flex items-center justify-center flex-shrink-0">
                  ${
                    imageUrl
                      ? `<img src="${imageUrl}" alt="${customer.name}" class="h-full w-full object-cover" onerror="this.parentElement.innerHTML='<span class=\\'text-xs text-slate-500\\'>IMG</span>'" />`
                      : '<span class="text-xs text-slate-500">IMG</span>'
                  }
                </div>
                <div class="flex-1">
                  <p class="text-base font-semibold text-slate-100 mb-1">${customer.name || "N/A"}</p>
                  <p class="text-xs text-slate-400 mb-1">${customer.email || "N/A"}</p>
                  <p class="text-xs text-slate-400">${customer.phone || "N/A"}</p>
                </div>
              </div>
              <div class="grid grid-cols-2 gap-3 text-xs">
                <div>
                  <p class="text-slate-500 mb-1">Vai trò</p>
                  <p class="text-slate-100">${customer.role === "admin" ? "Quản trị viên" : "Khách hàng"}</p>
                </div>
                <div>
                  <p class="text-slate-500 mb-1">Trạng thái</p>
                  <p class="text-slate-100">${customer.is_active ? "Hoạt động" : "Vô hiệu hóa"}</p>
                </div>
              </div>
            </div>

            <!-- Addresses List -->
            <div class="rounded-lg border border-slate-800 bg-slate-950/40 p-4">
              <h3 class="text-sm font-semibold text-slate-300 mb-3 flex items-center gap-2">
                <span class="material-symbols-outlined text-base">location_on</span>
                Danh sách địa chỉ (${customer.addresses && customer.addresses.length > 0 ? customer.addresses.length : 0})
              </h3>
              ${
                customer.addresses && customer.addresses.length > 0
                  ? `<div class="space-y-3">
                      ${customer.addresses.map((addr, index) => `
                        <div class="rounded-lg border border-slate-800 bg-slate-900/40 p-3">
                          <div class="flex items-start justify-between mb-2">
                            <p class="text-xs font-semibold text-slate-400">Địa chỉ #${index + 1}</p>
                          </div>
                          <div class="space-y-1 text-xs">
                            <p class="text-slate-300"><span class="text-slate-500">Tên:</span> ${addr.name || "N/A"}</p>
                            <p class="text-slate-300"><span class="text-slate-500">SĐT:</span> ${addr.phone || "N/A"}</p>
                            <p class="text-slate-300"><span class="text-slate-500">Địa chỉ:</span> ${addr.address || "N/A"}</p>
                          </div>
                        </div>
                      `).join('')}
                    </div>`
                  : `<p class="text-xs text-slate-500 text-center py-4">Chưa có địa chỉ nào</p>`
              }
            </div>

            <!-- Behavior Stats -->
            <div class="rounded-lg border border-slate-800 bg-slate-950/40 p-4">
              <h3 class="text-sm font-semibold text-slate-300 mb-3 flex items-center gap-2">
                <span class="material-symbols-outlined text-base">insights</span>
                Hành vi khách hàng
              </h3>
              <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-xs">
                <div class="rounded-lg border border-slate-800 bg-slate-900/40 p-3">
                  <p class="text-slate-500 mb-1">Tổng đơn hàng</p>
                  <p class="text-lg font-semibold text-blue-400">${behavior.total_orders || 0}</p>
                </div>
                <div class="rounded-lg border border-slate-800 bg-slate-900/40 p-3">
                  <p class="text-slate-500 mb-1">Tổng chi tiêu</p>
                  <p class="text-lg font-semibold text-emerald-400">${formatCurrency(behavior.total_spent || 0)}</p>
