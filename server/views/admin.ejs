<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trang quản lý Admin - Coffee Shop</title>
    <style>
        :root {
            color-scheme: dark;
            --bg: #0b1020;
            --surface: #0f172a;
            --surface-2: #111b34;
            --border: #1f2a44;
            --text: #e5e7eb;
            --muted: #a3adc2;
            --accent: #3b82f6;
            --accent-2: #1d4ed8;
            --success: #22c55e;
            --danger: #ef4444;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: "Inter", Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
        }

        a {
            color: inherit;
        }

        .app-shell {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 240px;
            background: #0c1226;
            border-right: 1px solid var(--border);
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .brand-avatar {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            background: var(--accent);
            display: grid;
            place-items: center;
            font-weight: bold;
        }

        .brand-title {
            font-size: 13px;
            color: var(--muted);
        }

        .brand-subtitle {
            font-size: 15px;
            font-weight: 600;
            color: var(--text);
        }

        .nav {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: 10px;
            text-decoration: none;
            color: var(--muted);
            transition: all 0.2s ease;
        }

        .nav-item:hover {
            background: rgba(59, 130, 246, 0.12);
            color: var(--text);
        }

        .nav-item.active {
            background: var(--surface-2);
            color: var(--text);
            border: 1px solid var(--border);
        }

        .sidebar-footer {
            margin-top: auto;
        }

        .btn-logout {
            width: 100%;
            padding: 10px 14px;
            border-radius: 10px;
            border: 1px solid var(--border);
            background: transparent;
            color: var(--text);
            cursor: pointer;
            font-weight: 600;
        }

        .btn-logout:hover {
            border-color: var(--accent);
            color: var(--accent);
        }

        .nav-item,
        .btn-logout,
        .btn-refresh,
        .card,
        .stat-card,
        .info-card {
            transition: background-color 0.2s ease, color 0.2s ease,
                border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
        }

        .card:hover,
        .stat-card:hover,
        .info-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.25);
        }

        .btn-logout:hover,
        .btn-refresh:hover,
        .nav-item:hover {
            transform: translateY(-1px);
        }

        .data-table tr {
            transition: background-color 0.2s ease;
        }

        .main-area {
            flex: 1;
            padding: 24px 32px;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 18px 22px;
            margin-bottom: 20px;
        }

        .page-label {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--muted);
        }

        .page-title {
            font-size: 22px;
            margin-top: 4px;
        }

        .page-description {
            color: var(--muted);
            margin-top: 6px;
            font-size: 13px;
        }

        .user-chip {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user-details {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 4px;
        }

        .user-name {
            font-weight: 600;
        }

        .user-email {
            color: var(--muted);
            font-size: 12px;
        }

        .user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: 1px solid var(--border);
            display: grid;
            place-items: center;
            font-weight: 600;
            background: #111827;
        }

        .content {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 20px 22px;
        }

        .welcome-card h2 {
            font-size: 20px;
        }

        .welcome-card p {
            color: var(--muted);
            margin-top: 6px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 16px;
        }

        .info-card {
            background: var(--surface-2);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 16px;
            text-decoration: none;
            color: inherit;
            transition: transform 0.2s ease, border 0.2s ease;
        }

        .info-card:hover {
            transform: translateY(-2px);
            border-color: rgba(59, 130, 246, 0.5);
        }

        .info-card h3 {
            font-size: 15px;
            margin-bottom: 6px;
        }

        .info-card p {
            font-size: 12px;
            color: var(--muted);
        }

        .section-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
        }

        .btn-refresh {
            padding: 6px 12px;
            border: 1px solid var(--border);
            background: transparent;
            color: var(--text);
            border-radius: 8px;
            cursor: pointer;
            font-size: 12px;
        }

        .btn-refresh:hover {
            border-color: var(--accent);
            color: var(--accent);
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
            margin-top: 16px;
        }

        .stat-card {
            background: #0f1a33;
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 16px;
        }

        .stat-title {
            font-size: 12px;
            color: var(--muted);
        }

        .stat-value {
            font-size: 22px;
            font-weight: 700;
            margin-top: 6px;
        }

        .stat-note {
            font-size: 11px;
            color: var(--muted);
            margin-top: 6px;
        }

        .stats-section {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .stats-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .date-range {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--muted);
            font-size: 13px;
        }

        .date-input {
            background: var(--surface-2);
            border: 1px solid var(--border);
            color: var(--text);
            padding: 6px 10px;
            border-radius: 8px;
            font-size: 12px;
        }

        .chart-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 16px;
        }

        .chart-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }



        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 13px;
            color: var(--muted);
        }

        .chart-total {
            color: var(--accent);
            font-weight: 600;
        }

        .chart-title {
            font-size: 14px;
            font-weight: 600;
            color: var(--text);
        }

        .chart-canvas {
            width: 100%;
            height: 220px;
        }



        .mini-charts {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .mini-chart {
            height: 160px;
        }

        .error-message {
            background: rgba(239, 68, 68, 0.12);
            color: #fecaca;
            padding: 12px 14px;
            border-radius: 10px;
            border: 1px solid rgba(239, 68, 68, 0.3);
        }

        @media (max-width: 980px) {
            .app-shell {
                flex-direction: column;
            }

            .sidebar {
                width: 100%;
                flex-direction: row;
                align-items: center;
                flex-wrap: wrap;
            }

            .nav {
                flex-direction: row;
                flex-wrap: wrap;
            }

            .main-area {
                padding: 16px;
            }

            .topbar {
                flex-direction: column;
                align-items: flex-start;
                gap: 12px;
            }

            .chart-grid {
                grid-template-columns: 1fr;
            }

            .user-details {
                align-items: flex-start;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            * {
                animation: none !important;
                transition: none !important;
            }
        }
    </style>
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <div class="brand">
                <div class="brand-avatar">CH</div>
                <div>
                    <div class="brand-title">Admin</div>
                    <div class="brand-subtitle">Coffee_Shop</div>
                </div>
            </div>
            <nav class="nav">
                <a class="nav-item active" href="/admin.html">Trang chủ</a>
                <a class="nav-item" href="/product.html">Sản phẩm</a>
                <a class="nav-item" href="/product-variant.html">Biến thể</a>
                <a class="nav-item" href="/category.html">Danh mục</a>
                <a class="nav-item" href="/order.html">Đơn hàng</a>
                <a class="nav-item" href="/admin/customers">Khách hàng</a>
                <a class="nav-item" href="#">Thống kê</a>
                <a class="nav-item" href="#">Banner</a>
            </nav>
            <div class="sidebar-footer">
                <button class="btn-logout" id="logoutBtn">Đăng xuất</button>
            </div>
        </aside>

        <div class="main-area">
            <header class="topbar">
                <div>
                    <div class="page-label">Bảng quản trị</div>
                    <div class="page-title">Trang chủ</div>
                    <div class="page-description">Chào mừng bạn quay lại hệ thống quản trị.</div>
                </div>
                <div class="user-chip">
                    <div class="user-details">
                        <span class="user-name" id="userNameTop"></span>
                        <span class="user-email" id="userEmail"></span>
                    </div>
                    <div class="user-avatar" aria-hidden="true">A</div>
                </div>
            </header>

            <div id="errorContainer"></div>

            <main class="content" id="mainContent">
                <section class="card" id="statsSection">
                    <div class="section-actions">
                        <h3>Tổng quan thống kê</h3>
                        <button class="btn-refresh" id="refreshStats">Tải lại</button>
                    </div>
                    <div class="stats-grid">
                        <div class="stat-card">
                            <div class="stat-title">Tổng danh mục</div>
                            <div class="stat-value" id="statCategoryCount">0</div>
                            <div class="stat-note">Danh mục đang hoạt động</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-title">Tổng sản phẩm</div>
                            <div class="stat-value" id="statProductCount">0</div>
                            <div class="stat-note">Sản phẩm đang bán</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-title">Cập nhật gần nhất</div>
                            <div class="stat-value" id="statUpdated">--:--</div>
                            <div class="stat-note">Thời điểm tải dữ liệu</div>
                        </div>
                    </div>
                </section>

                <section class="stats-section">
                    <div class="stats-toolbar">
                        <div>
                            <div class="page-label">Màn hình chính</div>
                            <div class="chart-title">Thống kê giao dịch</div>
                        </div>
                        <div class="date-range">
                            <input class="date-input" type="date" id="statStartDate" />
                            <span>Đến</span>
                            <input class="date-input" type="date" id="statEndDate" />
                            <button class="btn-refresh" id="refreshChart">Tải lại</button>
                        </div>
                    </div>

                    <div class="chart-grid">
                        <div class="chart-card">
                            <div class="chart-header">
                                <span>Tổng tiền giao dịch</span>
                                <span class="chart-total" id="totalRevenueLabel">Tổng: 0 VND</span>
                            </div>
                            <canvas class="chart-canvas" id="totalRevenueChart"></canvas>
                        </div>

                        <div class="mini-charts">
                            <div class="chart-card">
                                <div class="chart-header">
                                    <span>Giao dịch thành công</span>
                                    <span class="chart-total" id="successRevenueLabel">Tổng: 0 VND</span>
                                </div>
                                <canvas class="chart-canvas mini-chart" id="successRevenueChart"></canvas>
                            </div>
                            <div class="chart-card">
                                <div class="chart-header">
                                    <span>Giao dịch đang thực hiện</span>
                                    <span class="chart-total" id="pendingRevenueLabel">Tổng: 0 VND</span>
                                </div>
                                <canvas class="chart-canvas mini-chart" id="pendingRevenueChart"></canvas>
                            </div>
                        </div>
                    </div>
                </section>
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        // Lấy token từ URL hoặc localStorage
        const urlParams = new URLSearchParams(window.location.search);
        let token = urlParams.get('token') || localStorage.getItem('adminToken');
        let userData = JSON.parse(localStorage.getItem('adminUser') || '{}');

        function setUserInfo(name, email) {
            const userNameEl = document.getElementById('userName');
            const userNameTopEl = document.getElementById('userNameTop');
            const userEmailEl = document.getElementById('userEmail');
            const displayName = name || 'Admin';

            if (userNameEl) userNameEl.textContent = displayName;
            if (userNameTopEl) userNameTopEl.textContent = displayName;
            if (userEmailEl) userEmailEl.textContent = email || '';

            const avatarEl = document.querySelector('.user-avatar');
            if (avatarEl && displayName) {
                avatarEl.textContent = displayName.trim().charAt(0).toUpperCase();
            }
        }

        // Nếu có token từ URL, lưu vào localStorage
        if (urlParams.get('token') && !localStorage.getItem('adminToken')) {
            token = urlParams.get('token');
            localStorage.setItem('adminToken', token);
        }

        // Kiểm tra ban đầu với dữ liệu từ localStorage
        if (token && userData.role === 'admin') {
            setUserInfo(userData.fullName || userData.email, userData.email);
        } else if (!token) {
            // Không có token, chuyển về trang login
            showError('Bạn chưa đăng nhập. Vui lòng đăng nhập lại.');
            setTimeout(() => {
                window.location.href = '/login.html';
            }, 2000);
        }

        function showError(message) {
            const errorContainer = document.getElementById('errorContainer');
            const mainContent = document.getElementById('mainContent');
            errorContainer.innerHTML = `<div class="error-message">${message}</div>`;
            if (mainContent) mainContent.style.display = 'none';
        }

        // Function logout
        function logout() {
            console.log('Logout function called');
            // Xác nhận trước khi đăng xuất
            if (confirm('Bạn có chắc chắn muốn đăng xuất?')) {
                console.log('User confirmed logout');
                // Xóa token và user data khỏi localStorage
                localStorage.removeItem('adminToken');
                localStorage.removeItem('adminUser');
                
                // Xóa token khỏi URL nếu có
                if (window.location.href.includes('token=')) {
                    window.history.replaceState({}, document.title, '/admin.html');
                }
                
                // Chuyển về trang login
                window.location.href = '/login.html';
            }
        }
        
        // Đảm bảo function logout có thể được gọi từ global scope
        window.logout = logout;
        
        // Gắn event listener cho nút đăng xuất
        function setupLogoutButton() {
            const logoutBtn = document.getElementById('logoutBtn');
            console.log('Setting up logout button:', logoutBtn);
            if (logoutBtn) {
                logoutBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    console.log('Logout button clicked');
                    logout();
                });
                console.log('Logout button event listener attached');
            } else {
                console.error('Logout button not found!');
            }
        }
        
        // Gắn ngay nếu DOM đã sẵn sàng, nếu không thì chờ DOMContentLoaded
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', setupLogoutButton);
        } else {
            // DOM đã sẵn sàng, gắn ngay
            setupLogoutButton();
        }

        // Kiểm tra token với server (không block UI, chỉ verify ngầm)
        if (token) {
            fetch('/api/account/verify', {
                method: 'GET',
                headers: {
                    'Authorization': 'Bearer ' + token
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.data && data.data.user) {
                    // Token hợp lệ, cập nhật thông tin user nếu cần
                    if (data.data.user.role === 'admin') {
                        localStorage.setItem('adminUser', JSON.stringify(data.data.user));
                        setUserInfo(data.data.user.fullName || data.data.user.email, data.data.user.email);
                    } else {
                        showError('Bạn không có quyền truy cập. Chỉ admin mới được phép.');
                        setTimeout(() => {
                            window.location.href = '/login.html';
                        }, 2000);
                    }
                }
            })
            .catch(error => {
                console.error('Token verification error:', error);
                // Chỉ hiển thị lỗi nếu không có userData từ localStorage
                if (!userData || !userData.role) {
                    showError('Không thể xác thực phiên đăng nhập. Vui lòng đăng nhập lại.');
                    setTimeout(() => {
                        window.location.href = '/login.html';
                    }, 2000);
                }
            });
        }

        function updateStats({ categoryCount, productCount } = {}) {
            if (typeof categoryCount === 'number') {
                document.getElementById('statCategoryCount').textContent = categoryCount;
            }
            if (typeof productCount === 'number') {
                document.getElementById('statProductCount').textContent = productCount;
            }
            const now = new Date();
            const timeLabel = now.toLocaleTimeString('vi-VN', {
                hour: '2-digit',
                minute: '2-digit'
            });
            document.getElementById('statUpdated').textContent = timeLabel;
        }

        async function loadStats() {
            const headers = {};
            if (token) {
                headers['Authorization'] = 'Bearer ' + token;
            }
            const [categoryRes, productRes] = await Promise.all([
                fetch('/api/category', { headers }),
                fetch('/api/product', { headers })
            ]);
            const categoryData = await categoryRes.json();
            const productData = await productRes.json();
            const categories = (categoryData.data && categoryData.data.categories) || [];
            const products = (productData.data && productData.data.products) || [];
            updateStats({ categoryCount: categories.length, productCount: products.length });
        }

        const currencyFormatter = new Intl.NumberFormat('vi-VN');
        const formatCurrency = (value) => `${currencyFormatter.format(Math.round(value || 0))} VND`;
        const hourLabels = Array.from({ length: 24 }, (_, hour) => `${String(hour).padStart(2, '0')}:00`);
        let totalChart = null;
        let successChart = null;
        let pendingChart = null;

        function parseOrderDate(id) {
            if (!id || id.length < 8) return null;
            const timestamp = parseInt(id.substring(0, 8), 16) * 1000;
            return new Date(timestamp);
        }

        function resolveDateRange() {
            const startInput = document.getElementById('statStartDate');
            const endInput = document.getElementById('statEndDate');
            const today = new Date();
            const todayValue = today.toISOString().slice(0, 10);

            if (!startInput.value) startInput.value = todayValue;
            if (!endInput.value) endInput.value = todayValue;

            const startValue = startInput.value;
            const endValue = endInput.value;

            const startDate = new Date(`${startValue}T00:00:00`);
            const endDate = new Date(`${endValue}T23:59:59`);
            return { startDate, endDate };
        }

        function initCharts() {
            const totalCtx = document.getElementById('totalRevenueChart');
            const successCtx = document.getElementById('successRevenueChart');
            const pendingCtx = document.getElementById('pendingRevenueChart');

            if (!totalCtx || !successCtx || !pendingCtx || !window.Chart) return;

            totalChart = new Chart(totalCtx, {
                type: 'bar',
                data: {
                    labels: hourLabels,
                    datasets: [{
                        label: 'Tổng giao dịch',
                        data: Array(24).fill(0),
                        borderColor: '#3b82f6',
                        backgroundColor: 'rgba(59, 130, 246, 0.45)',
                        borderWidth: 1
                    }]
                },
                options: {
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { ticks: { color: '#a3adc2' }, grid: { color: 'rgba(255,255,255,0.06)' } },
                        x: { ticks: { color: '#a3adc2', autoSkip: false, maxRotation: 0 }, grid: { color: 'rgba(255,255,255,0.03)' } }
                    }
                }
            });

            successChart = new Chart(successCtx, {
                type: 'bar',
                data: {
                    labels: hourLabels,
                    datasets: [{
                        label: 'Thành công',
                        data: Array(24).fill(0),
                        borderColor: '#22c55e',
                        backgroundColor: 'rgba(34, 197, 94, 0.45)',
                        borderWidth: 1
                    }]
                },
                options: {
                    plugins: { legend: { display: false } },
                    scales: { y: { display: false }, x: { display: false } }
                }
            });

            pendingChart = new Chart(pendingCtx, {
                type: 'bar',
                data: {
                    labels: hourLabels,
                    datasets: [{
                        label: 'Đang thực hiện',
                        data: Array(24).fill(0),
                        borderColor: '#f59e0b',
                        backgroundColor: 'rgba(245, 158, 11, 0.45)',
                        borderWidth: 1
                    }]
                },
                options: {
                    plugins: { legend: { display: false } },
                    scales: { y: { display: false }, x: { display: false } }
                }
            });
        }

        function updateCharts({ total, success, pending, totalsByDay, successByDay, pendingByDay, labels }) {
            document.getElementById('totalRevenueLabel').textContent = `Tổng: ${formatCurrency(total)}`;
            document.getElementById('successRevenueLabel').textContent = `Tổng: ${formatCurrency(success)}`;
            document.getElementById('pendingRevenueLabel').textContent = `Tổng: ${formatCurrency(pending)}`;

            if (totalChart) {
                totalChart.data.labels = labels;
                totalChart.data.datasets[0].data = totalsByDay;
                totalChart.update();
            }
            if (successChart) {
                successChart.data.labels = labels;
                successChart.data.datasets[0].data = successByDay;
                successChart.update();
            }
            if (pendingChart) {
                pendingChart.data.labels = labels;
                pendingChart.data.datasets[0].data = pendingByDay;
                pendingChart.update();
            }
        }

        async function loadTransactionStats() {
            const { startDate, endDate } = resolveDateRange();
            const headers = {};
            if (token) {
                headers['Authorization'] = 'Bearer ' + token;
            }
            const response = await fetch('/api/order?include=detail', { headers });
            const data = await response.json();
            if (!response.ok) {
                console.error('Load orders error:', data.error || data.msg);
                return;
            }

            const orders = (data.data && data.data.orders) || [];
            const dayLabels = [];
            const totalsByDay = [];
            const successByDay = [];
            const pendingByDay = [];
            const dayIndexMap = new Map();
            const cursor = new Date(startDate);
            while (cursor <= endDate) {
                const dayKey = cursor.toISOString().slice(0, 10);
                dayIndexMap.set(dayKey, dayLabels.length);
                dayLabels.push(dayKey.split('-').reverse().join('-'));
                totalsByDay.push(0);
                successByDay.push(0);
                pendingByDay.push(0);
                cursor.setDate(cursor.getDate() + 1);
            }
            let total = 0;
            let success = 0;
            let pending = 0;

            orders.forEach((order) => {
                const createdAt = parseOrderDate(order._id);
                if (!createdAt || createdAt < startDate || createdAt > endDate) return;
                const amount = Number(order.total_amount) || 0;
                const dayKey = createdAt.toISOString().slice(0, 10);
                const dayIndex = dayIndexMap.get(dayKey);
                if (typeof dayIndex === 'undefined') return;

                total += amount;
                totalsByDay[dayIndex] += amount;

                const method = String(order.paymentMethod || '').toLowerCase();
                const paymentStatus = String(order.paymentStatus || '').toUpperCase();
                const isCash = method === 'cash' || method === '';
                const isSuccess = isCash || paymentStatus === 'PAID';
                const isPending = method === 'vnpay' && paymentStatus !== 'PAID';

                if (isSuccess) {
                    success += amount;
                    successByDay[dayIndex] += amount;
                } else if (isPending) {
                    pending += amount;
                    pendingByDay[dayIndex] += amount;
                }
            });

            const maxDays = 5;
            const startIndex = Math.max(0, dayLabels.length - maxDays);
            const labels = dayLabels.slice(startIndex);
            const totalsSlice = totalsByDay.slice(startIndex);
            const successSlice = successByDay.slice(startIndex);
            const pendingSlice = pendingByDay.slice(startIndex);

            updateCharts({
                total,
                success,
                pending,
                totalsByDay: totalsSlice,
                successByDay: successSlice,
                pendingByDay: pendingSlice,
                labels
            });
        }

        const refreshStatsBtn = document.getElementById('refreshStats');
        if (refreshStatsBtn) {
            refreshStatsBtn.addEventListener('click', async () => {
                loadStats();
            });
        }

        const refreshChartBtn = document.getElementById('refreshChart');
        if (refreshChartBtn) {
            refreshChartBtn.addEventListener('click', async () => {
                loadTransactionStats();
            });
        }

        const startDateInput = document.getElementById('statStartDate');
        const endDateInput = document.getElementById('statEndDate');
        if (startDateInput && endDateInput) {
            startDateInput.addEventListener('change', loadTransactionStats);
            endDateInput.addEventListener('change', loadTransactionStats);
        }

        initCharts();
        loadStats();
        loadTransactionStats();
    </script>
</body>
</html>
