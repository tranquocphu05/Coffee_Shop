<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý đơn hàng - Coffee Shop</title>
    <style>
        :root {
            color-scheme: dark;
            --bg: #0b1020;
            --surface: #0f172a;
            --surface-2: #111b34;
            --border: #1f2a44;
            --text: #e5e7eb;
            --muted: #a3adc2;
            --accent: #3b82f6;
            --accent-2: #1d4ed8;
            --success: #22c55e;
            --danger: #ef4444;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: "Inter", Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
        }

        a {
            color: inherit;
        }

        .app-shell {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 240px;
            background: #0c1226;
            border-right: 1px solid var(--border);
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .brand-avatar {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            background: var(--accent);
            display: grid;
            place-items: center;
            font-weight: bold;
        }

        .brand-title {
            font-size: 13px;
            color: var(--muted);
        }

        .brand-subtitle {
            font-size: 15px;
            font-weight: 600;
            color: var(--text);
        }

        .nav {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: 10px;
            text-decoration: none;
            color: var(--muted);
            transition: all 0.2s ease;
        }

        .nav-item:hover {
            background: rgba(59, 130, 246, 0.12);
            color: var(--text);
        }

        .nav-item.active {
            background: var(--surface-2);
            color: var(--text);
            border: 1px solid var(--border);
        }

        .sidebar-footer {
            margin-top: auto;
        }

        .btn-ghost {
            width: 100%;
            padding: 10px 14px;
            border-radius: 10px;
            border: 1px solid var(--border);
            background: transparent;
            color: var(--text);
            cursor: pointer;
            font-weight: 600;
        }

        .btn-ghost:hover {
            border-color: var(--accent);
            color: var(--accent);
        }

        .main-area {
            flex: 1;
            padding: 24px 32px;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 18px 22px;
            margin-bottom: 20px;
        }

        .page-label {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--muted);
        }

        .page-title {
            font-size: 22px;
            margin-top: 4px;
        }

        .page-description {
            color: var(--muted);
            margin-top: 6px;
            font-size: 13px;
        }

        .content-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 360px;
            gap: 20px;
        }

        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 20px 22px;
        }

        .section-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
        }

        .btn-refresh {
            padding: 6px 12px;
            border: 1px solid var(--border);
            background: transparent;
            color: var(--text);
            border-radius: 8px;
            cursor: pointer;
            font-size: 12px;
        }

        .btn-refresh:hover {
            border-color: var(--accent);
            color: var(--accent);
        }

        .form-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 12px;
            margin-top: 12px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .form-group label {
            font-size: 12px;
            color: var(--muted);
            font-weight: 600;
        }

        .form-group input,
        .form-group select {
            padding: 8px 10px;
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 13px;
            background: #0c142b;
            color: var(--text);
        }

        .status-select {
            min-width: 120px;
            padding: 6px 10px;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: #0c142b;
            color: var(--text);
            font-size: 12px;
        }

        .btn-primary {
            padding: 8px 14px;
            background: var(--accent);
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 13px;
            font-weight: bold;
        }

        .btn-secondary {
            padding: 8px 14px;
            background: rgba(59, 130, 246, 0.12);
            color: var(--text);
            border: 1px solid var(--border);
            border-radius: 8px;
            cursor: pointer;
            font-size: 13px;
            font-weight: bold;
        }

        .btn-danger {
            padding: 6px 10px;
            background: rgba(239, 68, 68, 0.16);
            color: #fecaca;
            border: 1px solid rgba(239, 68, 68, 0.4);
            border-radius: 6px;
            cursor: pointer;
            font-size: 12px;
            font-weight: bold;
        }

        .btn-action {
            padding: 6px 10px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 12px;
            font-weight: bold;
            border: 1px solid transparent;
        }

        .btn-edit {
            background: rgba(59, 130, 246, 0.16);
            color: #bfdbfe;
            border-color: rgba(59, 130, 246, 0.4);
        }

        .table-actions {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }

        .form-message {
            margin-top: 10px;
            font-size: 12px;
        }

        .form-message.error {
            color: #fecaca;
        }

        .form-message.success {
            color: #bbf7d0;
        }

        .table-empty {
            color: var(--muted);
            margin-top: 10px;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
            font-size: 13px;
        }

        .data-table th,
        .data-table td {
            border-bottom: 1px solid var(--border);
            padding: 10px;
            text-align: left;
        }

        .data-table th {
            color: var(--muted);
            font-weight: 600;
            font-size: 12px;
            text-transform: uppercase;
        }

        .data-table tr:hover {
            background: rgba(59, 130, 246, 0.08);
        }

        .cell-customer {
            cursor: pointer;
            color: #bfdbfe;
            font-weight: 600;
        }

        .cell-customer:hover {
            color: #60a5fa;
        }

        .modal {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.6);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            z-index: 1000;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity 0.2s ease, visibility 0.2s ease;
        }

        .modal.open {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
        }

        .modal-content {
            width: min(860px, 100%);
            max-height: 90vh;
            overflow: auto;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 18px 20px;
            transform: translateY(8px);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35);
        }

        .modal.open .modal-content {
            transform: translateY(0);
        }

        .modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 10px;
        }

        .modal-close {
            border: 1px solid var(--border);
            background: transparent;
            color: var(--muted);
            border-radius: 8px;
            padding: 4px 10px;
            cursor: pointer;
            font-size: 16px;
            line-height: 1;
        }

        .modal-close:hover {
            border-color: var(--accent);
            color: var(--accent);
        }

        .nav-item,
        .btn-ghost,
        .btn-refresh,
        .btn-primary,
        .btn-secondary,
        .btn-danger,
        .btn-action,
        .card {
            transition: background-color 0.2s ease, color 0.2s ease,
                border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
        }

        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.25);
        }

        .btn-primary:hover,
        .btn-secondary:hover,
        .btn-refresh:hover,
        .btn-ghost:hover,
        .btn-action:hover,
        .nav-item:hover {
            transform: translateY(-1px);
        }

        .data-table tr {
            transition: background-color 0.2s ease;
        }

        @media (max-width: 1100px) {
            .content-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 980px) {
            .app-shell {
                flex-direction: column;
            }

            .sidebar {
                width: 100%;
                flex-direction: row;
                align-items: center;
                flex-wrap: wrap;
            }

            .nav {
                flex-direction: row;
                flex-wrap: wrap;
            }

            .main-area {
                padding: 16px;
            }

            .topbar {
                flex-direction: column;
                align-items: flex-start;
                gap: 12px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            * {
                animation: none !important;
                transition: none !important;
            }
        }
    </style>
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <div class="brand">
                <div class="brand-avatar">CH</div>
                <div>
                    <div class="brand-title">Admin</div>
                    <div class="brand-subtitle">Coffee_Shop</div>
                </div>
            </div>
            <nav class="nav">
                <a class="nav-item" href="/admin.html">Trang chủ</a>
                <a class="nav-item" href="/product.html">Sản phẩm</a>
                <a class="nav-item" href="/product-variant.html">Biến thể</a>
                <a class="nav-item" href="/category.html">Danh mục</a>
                <a class="nav-item active" href="/order.html">Đơn hàng</a>
                <a class="nav-item" href="/admin/customers">Khách hàng</a>
                <a class="nav-item" href="#">Thống kê</a>
                <a class="nav-item" href="#">Banner</a>
            </nav>
            <div class="sidebar-footer">
                <a class="btn-ghost" href="/admin.html">Về trang Admin</a>
            </div>
        </aside>

        <div class="main-area">
            <header class="topbar">
                <div>
                    <div class="page-label">Bảng quản trị</div>
                    <div class="page-title">Quản lý đơn hàng</div>
                    <div class="page-description">Theo dõi và cập nhật trạng thái đơn hàng.</div>
                </div>
            </header>

            <div class="content-grid">
                <section class="card">
                    <div class="section-actions">
                        <h3>Danh sách đơn hàng</h3>
                        <button class="btn-refresh" id="refreshOrders">Tải lại</button>
                    </div>
                    <div id="orderStatus" class="table-empty">Đang tải dữ liệu...</div>
                    <table class="data-table" id="orderTable" style="display: none;">
                        <thead>
                            <tr>
                                <th>Khách hàng</th>
                                <th>Địa chỉ</th>
                                <th>Số điện thoại</th>
                                <th>Trạng thái</th>
                                <th>Tổng tiền</th>
                                <th>Hành động</th>
                            </tr>
                        </thead>
                        <tbody id="orderTableBody"></tbody>
                    </table>
                </section>
            </div>
        </div>
    </div>

    <div class="modal" id="editOrderModal" aria-hidden="true">
        <div class="modal-content">
            <div class="modal-header">
                <h4>Chi tiết đơn hàng</h4>
                <button type="button" class="modal-close" id="closeEditOrderModal">&times;</button>
            </div>
            <form id="editOrderForm">
                <div class="form-row">
                    <div class="form-group">
                        <label for="editOrderUserId">Khách hàng</label>
                        <input type="text" id="editOrderUserId" name="editOrderUserId" readonly>
                    </div>
                    <div class="form-group">
                        <label for="editOrderAddressId">Địa chỉ</label>
                        <input type="text" id="editOrderAddressId" name="editOrderAddressId" readonly>
                    </div>
                    <div class="form-group">
                        <label for="editOrderStatus">Trạng thái</label>
                        <select id="editOrderStatus" name="editOrderStatus" required disabled>
                            <option value="pending">Chờ xử lý</option>
                            <option value="processing">Đang xử lý</option>
                            <option value="shipping">Đang giao</option>
                            <option value="delivered">Đã giao</option>
                            <option value="cancelled">Đã hủy</option>
                        </select>
                    </div>
                </div>
                <div class="form-row" style="grid-template-columns: auto 1fr; align-items: center;">
                    <button type="button" class="btn-secondary" id="cancelEditOrder">Đóng</button>
                    <div id="editOrderMessage" class="form-message"></div>
                </div>
            </form>
        </div>
    </div>

    <script>
        const urlParams = new URLSearchParams(window.location.search);
        let token = urlParams.get('token') || localStorage.getItem('adminToken');
        let currentEditId = null;
        let orderMap = {};
        const editOrderModal = document.getElementById('editOrderModal');
        const statusOptions = [
            { value: 'pending', label: 'Chờ xử lý' },
            { value: 'processing', label: 'Đang xử lý' },
            { value: 'shipping', label: 'Đang giao' },
            { value: 'delivered', label: 'Đã giao' },
            { value: 'cancelled', label: 'Đã hủy' }
        ];

        function openEditOrderModal() {
            if (!editOrderModal) return;
            editOrderModal.classList.add('open');
            editOrderModal.setAttribute('aria-hidden', 'false');
        }

        function closeEditOrderModal() {
            if (!editOrderModal) return;
            editOrderModal.classList.remove('open');
            editOrderModal.setAttribute('aria-hidden', 'true');
            const editOrderMessage = document.getElementById('editOrderMessage');
            editOrderMessage.textContent = '';
            editOrderMessage.className = 'form-message';
        }

        async function fetchOrders() {
            const orderStatus = document.getElementById('orderStatus');
            const orderTable = document.getElementById('orderTable');
            const orderTableBody = document.getElementById('orderTableBody');

            orderStatus.textContent = 'Đang tải dữ liệu...';
            orderTable.style.display = 'none';
            orderTableBody.innerHTML = '';

            try {
                const headers = {};
                if (token) {
                    headers['Authorization'] = 'Bearer ' + token;
                }
                const response = await fetch('/api/order?include=detail', { headers });
                const data = await response.json();

                if (!response.ok) {
                    orderStatus.textContent = data.error || 'Không thể tải đơn hàng.';
                    return;
                }

                const orders = (data.data && data.data.orders) || [];
                if (orders.length === 0) {
                    orderStatus.textContent = 'Chưa có đơn hàng nào.';
                    return;
                }

                orderMap = {};
                orderTableBody.innerHTML = orders
                    .map((order) => {
                        orderMap[String(order._id)] = order;
                        const totalAmount = typeof order.total_amount === 'number' ? order.total_amount : '-';
                        const userLabel = order.user?.name || order.address?.name || 'Ẩn danh';
                        const addressLabel = order.address?.address || '';
                        const phoneLabel = order.address?.phone || '';
                        const statusSelect = `
                            <select class="status-select" data-id="${order._id}">
                                ${statusOptions
                                    .map((status) => `
                                        <option value="${status.value}" ${order.status === status.value ? 'selected' : ''}>
                                            ${status.label}
                                        </option>
                                    `)
                                    .join('')}
                            </select>
                        `;
                        return `
                            <tr>
                                <td class="cell-customer" data-id="${order._id}">${userLabel}</td>
                                <td>${addressLabel}</td>
                                <td>${phoneLabel}</td>
                                <td>${statusSelect}</td>
                                <td>${totalAmount}</td>
                                <td>
                                    <div class="table-actions">
                                        <button class="btn-action btn-edit btn-update" data-id="${order._id}">Cập nhật</button>
                                        <button class="btn-action btn-danger" data-id="${order._id}">Xóa</button>
                                    </div>
                                </td>
                            </tr>
                        `;
                    })
                    .join('');

                orderStatus.textContent = '';
                orderTable.style.display = 'table';
            } catch (error) {
                console.error('Fetch orders error:', error);
                orderStatus.textContent = 'Lỗi tải đơn hàng.';
            }
        }

        async function updateOrder(id, payload) {
            const editOrderMessage = document.getElementById('editOrderMessage');
            editOrderMessage.textContent = '';
            editOrderMessage.className = 'form-message';

            try {
                const headers = { 'Content-Type': 'application/json' };
                if (token) {
                    headers['Authorization'] = 'Bearer ' + token;
                }
                const response = await fetch(`/api/order/${id}`, {
                    method: 'PUT',
                    headers,
                    body: JSON.stringify(payload)
                });
                const data = await response.json();

                if (!response.ok) {
                    editOrderMessage.textContent = data.error || 'Không thể cập nhật đơn hàng.';
                    editOrderMessage.classList.add('error');
                    return false;
                }

                editOrderMessage.textContent = 'Cập nhật đơn hàng thành công!';
                editOrderMessage.classList.add('success');
                return true;
            } catch (error) {
                console.error('Update order error:', error);
                editOrderMessage.textContent = 'Lỗi cập nhật đơn hàng.';
                editOrderMessage.classList.add('error');
                return false;
            }
        }

        async function deleteOrder(id) {
            try {
                const headers = {};
                if (token) {
                    headers['Authorization'] = 'Bearer ' + token;
                }
                const response = await fetch(`/api/order/${id}`, {
                    method: 'DELETE',
                    headers
                });
                const data = await response.json();
                if (!response.ok) {
                    alert(data.error || 'Không thể xóa đơn hàng.');
                    return false;
                }
                return true;
            } catch (error) {
                console.error('Delete order error:', error);
                alert('Lỗi xóa đơn hàng.');
                return false;
            }
        }

        const refreshOrdersBtn = document.getElementById('refreshOrders');
        if (refreshOrdersBtn) {
            refreshOrdersBtn.addEventListener('click', fetchOrders);
        }

        const editOrderForm = document.getElementById('editOrderForm');
        if (editOrderForm) {
            editOrderForm.addEventListener('submit', (event) => {
                event.preventDefault();
            });
        }

        const cancelEditOrder = document.getElementById('cancelEditOrder');
        if (cancelEditOrder) {
            cancelEditOrder.addEventListener('click', () => {
                currentEditId = null;
                closeEditOrderModal();
            });
        }

        const closeEditOrderModalBtn = document.getElementById('closeEditOrderModal');
        if (closeEditOrderModalBtn) {
            closeEditOrderModalBtn.addEventListener('click', () => {
                currentEditId = null;
                closeEditOrderModal();
            });
        }

        if (editOrderModal) {
            editOrderModal.addEventListener('click', (event) => {
                if (event.target === editOrderModal) {
                    currentEditId = null;
                    closeEditOrderModal();
                }
            });
        }

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && editOrderModal?.classList.contains('open')) {
                currentEditId = null;
                closeEditOrderModal();
            }
        });

        const orderTableBody = document.getElementById('orderTableBody');
        if (orderTableBody) {
            orderTableBody.addEventListener('click', async (event) => {
                const target = event.target;
                if (!(target instanceof HTMLElement)) {
                    return;
                }
                if (target.classList.contains('btn-update')) {
                    const id = target.getAttribute('data-id');
                    if (!id) return;
                    const select = orderTableBody.querySelector(`.status-select[data-id="${id}"]`);
                    if (!select) return;
                    const status = select.value.trim();
                    if (!status) return;
                    const updated = await updateOrder(id, { status });
                    if (updated) {
                        fetchOrders();
                    }
                }
                if (target.classList.contains('cell-customer')) {
                    const id = target.getAttribute('data-id');
                    if (!id || !orderMap[id]) return;
                    const order = orderMap[id];
                    currentEditId = id;
                    const editOrderUserId = document.getElementById('editOrderUserId');
                    const editOrderAddressId = document.getElementById('editOrderAddressId');
                    const editOrderStatus = document.getElementById('editOrderStatus');
                    editOrderUserId.value = order.user?.name || order.address?.name || 'Ẩn danh';
                    editOrderAddressId.value = order.address
                        ? `${order.address.address || ''}${order.address.phone ? ` - ${order.address.phone}` : ''}`
                        : '';
                    editOrderStatus.value = order.status || '';
                    openEditOrderModal();
                }
                if (target.classList.contains('btn-danger')) {
                    const id = target.getAttribute('data-id');
                    if (!id) return;
                    if (!confirm('Bạn có chắc chắn muốn xóa đơn hàng này?')) {
                        return;
                    }
                    const deleted = await deleteOrder(id);
                    if (deleted) {
                        fetchOrders();
                    }
                }
            });
        }

        fetchOrders();
    </script>
</body>
</html>
